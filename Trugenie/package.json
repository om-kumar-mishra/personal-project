    "react": "^18.2.0",
    "react-apexcharts": "^1.4.0",
    "react-base-app": "file:",
    "react-bootstrap": "^2.7.0",
    "react-bootstrap-v5": "^1.4.0",
    "react-datepicker": "^4.8.0",
    "react-dom": "^18.2.0",
