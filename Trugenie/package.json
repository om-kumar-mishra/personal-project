{
  "name": "react-base-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode test",
    "nike": "vite --mode nike",
    "build": "tsc && vite build",
    "build:test": "tsc && vite build --mode test",
    "build:dev": "tsc && vite build --mode dev",
    "build:uat": "tsc && vite build --mode uat",
    "build:nike": "tsc && vite build --mode nike",
